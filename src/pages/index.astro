---
import Layout from '../layouts/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import PatentCard from '../components/PatentCard.astro';
import { publications } from '../data/publications';
import { patents } from '../data/patents';

const featuredPublications = publications.filter((publication) => publication.featured);

const researchDomains = [
  {
    icon: 'fa-satellite-dish',
    number: '01',
    title: 'Computational imaging',
    description: 'I design sensing systems that recover depth, vibration, and hidden structure from time-of-flight, Schlieren, and multi-camera measurements.',
    topics: ['Time-of-flight', 'Scientific imaging', 'Tomography', 'Sensor fusion'],
  },
  {
    icon: 'fa-cube',
    number: '02',
    title: 'Differentiable rendering',
    description: 'I connect physics-based image formation to optimization—building forward models, adjoints, and inverse renderers for optical and acoustic scenes.',
    topics: ['Inverse rendering', 'Gaussian splatting', 'Neural fields', 'Mitsuba / Dr.Jit'],
  },
  {
    icon: 'fa-microchip',
    number: '03',
    title: 'GPU reconstruction',
    description: 'I write custom CUDA and OptiX systems for high-throughput simulation, reconstruction, and analysis across unconventional sensing modalities.',
    topics: ['CUDA', 'OptiX', 'PyTorch / JAX', 'High-performance computing'],
  },
];

const toolkit = [
  { label: 'Sensing', value: 'ToF · Schlieren · RGB · Multimodal', icon: 'fa-wave-square' },
  { label: 'Representation', value: 'Gaussian splats · Neural fields · Spherical harmonics', icon: 'fa-shapes' },
  { label: 'Compute', value: 'CUDA · OptiX · PyTorch · JAX · Dr.Jit', icon: 'fa-gauge-high' },
];
---

<Layout
  title="Omkar Vengurlekar — Computational Imaging & Differentiable Rendering"
  description="Omkar Vengurlekar is a Ph.D. researcher building computational imaging systems, differentiable renderers, and neural 3D reconstruction methods."
>
  <main>
    <section class="hero-section">
      <img
        src="/images/computational-imaging-hero.webp"
        alt="A point-cloud reconstruction illuminated by optical and acoustic wavefronts"
        class="hero-art"
        width="1672"
        height="940"
        fetchpriority="high"
      />
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="scan-beam" aria-hidden="true"></div>

      <div class="relative mx-auto grid min-h-[calc(100svh-72px)] max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8">
        <div class="max-w-3xl">
          <p class="eyebrow">Ph.D. researcher · Arizona State University</p>
          <h1 class="mt-7 text-5xl font-bold leading-[0.98] tracking-[-0.055em] text-white sm:text-6xl lg:text-[5rem]">
            I build imaging systems that see what
            <span class="gradient-text">conventional cameras cannot.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl sm:leading-9">
            I’m Omkar Vengurlekar, a computational imaging researcher working across differentiable rendering, neural scene representations, time-of-flight sensing, and 3D reconstruction.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/publications" class="button-primary">
              Explore my research
              <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
            </a>
            <a href="/files/Omkar_Vengurlekar_Resume.pdf" target="_blank" rel="noopener noreferrer" class="button-secondary">
              <i class="fas fa-file-arrow-down" aria-hidden="true"></i>
              Résumé PDF
            </a>
            <a href="mailto:ovengurl@asu.edu" class="button-secondary" aria-label="Email Omkar Vengurlekar">
              <i class="fas fa-envelope" aria-hidden="true"></i>
            </a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
            <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-cyan-300 shadow-[0_0_12px_#67e8f9]"></span> Time-of-flight</span>
            <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-violet-300 shadow-[0_0_12px_#c4b5fd]"></span> Neural rendering</span>
            <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-teal-300 shadow-[0_0_12px_#5eead4]"></span> Multimodal 3D</span>
          </div>
        </div>

        <aside class="glass-panel justify-self-end p-5 sm:p-6 lg:w-[25rem]" aria-label="Research profile summary">
          <div class="flex items-center gap-4 border-b border-cyan-200/10 pb-5">
            <img
              src="/images/OmkarVengurlekar.JPEG"
              alt="Omkar Vengurlekar"
              class="h-16 w-16 rounded-xl object-cover object-top ring-1 ring-cyan-200/25"
              width="96"
              height="96"
            />
            <div>
              <p class="text-base font-bold text-white">Omkar Vengurlekar</p>
              <p class="mt-1 text-xs leading-5 text-slate-400">Imaging Lyceum Lab · ASU</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3 py-5">
            <div>
              <p class="text-2xl font-black tracking-tight text-cyan-100">10M</p>
              <p class="mt-1 text-[10px] uppercase leading-4 tracking-[0.12em] text-slate-500">depth samples / s</p>
            </div>
            <div class="border-x border-cyan-200/10 px-3">
              <p class="text-2xl font-black tracking-tight text-violet-200">02</p>
              <p class="mt-1 text-[10px] uppercase leading-4 tracking-[0.12em] text-slate-500">patents filed</p>
            </div>
            <div>
              <p class="text-2xl font-black tracking-tight text-teal-200">06</p>
              <p class="mt-1 text-[10px] uppercase leading-4 tracking-[0.12em] text-slate-500">publications</p>
            </div>
          </div>

          <div class="signal-line" aria-hidden="true"></div>
          <div class="mt-5 flex items-start justify-between gap-5">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">Current research signal</p>
              <p class="mt-2 text-sm leading-6 text-slate-300">Physics-guided reconstruction of depth, motion, and invisible refractive fields.</p>
            </div>
            <i class="fas fa-wave-square mt-1 text-cyan-300" aria-hidden="true"></i>
          </div>
        </aside>
      </div>
    </section>

    <section id="patents" class="section-shell scroll-mt-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="section-kicker">Patents</p>
            <h2 class="section-heading">From research signals to protected systems.</h2>
          </div>
          <div class="lg:justify-self-end">
            <p class="section-copy max-w-2xl">
              Two U.S. provisional applications translate high-speed optical sensing and physics-guided 3D reconstruction into protectable technology.
            </p>
            <a href="/patents" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-200 transition hover:text-white">
              View filing details <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="mt-12 grid gap-6 xl:grid-cols-2">
          {patents.map((patent, index) => <PatentCard patent={patent} index={index} compact />)}
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="section-kicker">Research spectrum</p>
            <h2 class="section-heading">From physical signals to 3D understanding.</h2>
          </div>
          <p class="section-copy max-w-2xl lg:justify-self-end">
            My work spans the full imaging pipeline: I build sensing hardware, model how signals propagate, write differentiable renderers, and optimize scene representations on the GPU.
          </p>
        </div>

        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          {researchDomains.map((domain) => (
            <article class="domain-card">
              <div class="relative z-10 flex items-start justify-between">
                <div class="domain-icon"><i class={`fas ${domain.icon}`} aria-hidden="true"></i></div>
                <span class="text-xs font-black tracking-[0.2em] text-slate-700">{domain.number}</span>
              </div>
              <div class="relative z-10 mt-12">
                <h3 class="text-2xl font-bold tracking-tight text-white">{domain.title}</h3>
                <p class="mt-4 text-sm leading-7 text-slate-400">{domain.description}</p>
                <div class="mt-7 flex flex-wrap gap-2">
                  {domain.topics.map((topic) => <span class="topic-chip">{topic}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell border-y border-cyan-300/10 bg-slate-950/35">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="section-kicker">Selected publications</p>
            <h2 class="section-heading">Recent work</h2>
          </div>
          <a href="/publications" class="button-secondary w-fit">
            View all publications
            <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
          </a>
        </div>

        <div class="mt-12 grid gap-6">
          {featuredPublications.map((publication, index) => (
            <PublicationCard publication={publication} index={index} compact={index > 0} />
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="glass-panel overflow-hidden">
          <div class="grid lg:grid-cols-[0.72fr_1.28fr]">
            <div class="border-b border-cyan-200/10 p-7 sm:p-10 lg:border-b-0 lg:border-r">
              <p class="section-kicker">Research toolkit</p>
              <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-white sm:text-4xl">Hardware, physics, code.</h2>
              <p class="mt-5 text-sm leading-7 text-slate-400">I own the pipeline from calibrated capture and signal processing to differentiable simulation and GPU reconstruction.</p>
            </div>
            <div class="grid divide-y divide-cyan-200/10 lg:divide-y-0">
              {toolkit.map((item) => (
                <div class="group flex gap-5 p-7 transition hover:bg-cyan-950/15 sm:p-8">
                  <div class="domain-icon shrink-0"><i class={`fas ${item.icon}`} aria-hidden="true"></i></div>
                  <div>
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{item.label}</p>
                    <p class="mt-2 text-base leading-7 text-slate-200">{item.value}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-violet-300/15 bg-gradient-to-br from-violet-950/50 via-slate-900 to-cyan-950/50 p-8 sm:p-12">
          <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-cyan-400/10 blur-3xl" aria-hidden="true"></div>
          <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
            <div>
              <p class="section-kicker">Open to research collaborations</p>
              <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-[-0.04em] text-white sm:text-4xl">Let’s build imaging systems for the signals cameras miss.</h2>
            </div>
            <a href="/contact" class="button-primary w-fit">Start a conversation <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
