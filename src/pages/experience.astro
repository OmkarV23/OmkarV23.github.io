---
import Layout from '../layouts/Layout.astro';

const experiences = [
  {
    organization: 'Arizona State University · Imaging Lyceum Lab',
    role: 'Graduate Research Assistant',
    location: 'Tempe, Arizona',
    period: 'January 2024 — Present',
    accent: 'bg-cyan-300',
    details: [
      'Developing optical time-of-flight sensing, differentiable rendering, neural 3D reconstruction, and multimodal imaging systems.',
      'Built custom CUDA autograd kernels, OptiX transient renderers, and GPU inverse-rendering pipelines for sonar, Gaussian splatting, and refractive fields.',
      'Published co-first-author work at ACM TOG / SIGGRAPH Asia 2026 and first-author oral work at 3DV 2026.',
    ],
  },
  {
    organization: 'Chiba University',
    role: 'Visiting Ph.D. Student',
    location: 'Chiba, Japan',
    period: 'July 2026 — August 2026',
    accent: 'bg-violet-300',
    details: [
      'Developed differentiable Background-Oriented Schlieren tomography for time-varying 3D refractive-index reconstruction.',
      'Built a synthetic-to-real pipeline with GPU flow simulation, calibrated multi-camera rendering, and measurement-only reconstruction.',
      'Validated the system on a six-camera rig imaging density-driven flows in air and water.',
    ],
  },
  {
    organization: 'Dartmouth College',
    role: 'Visiting Ph.D. Student',
    location: 'Hanover, New Hampshire',
    period: 'May 2024 — July 2024',
    accent: 'bg-teal-300',
    details: [
      'Prototyped acoustic non-line-of-sight imaging hardware and acousto-optic capture of occluded surfaces.',
      'Collaborated with the Rendering and Imaging Science Lab on multimodal computational imaging systems.',
    ],
  },
  {
    organization: 'RAIN AI',
    role: 'AI Hardware and Systems Intern',
    location: 'Remote, USA',
    period: 'August 2023 — December 2023',
    accent: 'bg-cyan-300',
    details: [
      'Implemented custom CUDA kernels for pretrained machine-learning workloads.',
      'Benchmarked GPU performance against custom AI accelerator hardware.',
    ],
  },
  {
    organization: 'Automaton AI',
    role: 'Computer Vision Engineer',
    location: 'Pune, India',
    period: 'March 2021 — July 2022',
    accent: 'bg-violet-300',
    details: [
      'Designed an end-to-end automatic data-annotation pipeline for detection, segmentation, and keypoint tasks.',
      'Deployed efficient model inference on NVIDIA edge devices using post-training quantization.',
    ],
  },
];
---

<Layout title="Experience — Omkar Vengurlekar">
  <main>
    <header class="page-hero">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="eyebrow">Research experience</p>
        <h1 class="mt-6 max-w-5xl text-5xl font-bold tracking-[-0.055em] text-white sm:text-6xl lg:text-7xl">
          Building across hardware, <span class="gradient-text">physics, and code.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">A research path through computational imaging labs, GPU systems, and production computer vision.</p>
      </div>
    </header>

    <section class="page-content">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="relative space-y-6 before:absolute before:bottom-5 before:left-[1.18rem] before:top-5 before:w-px before:bg-gradient-to-b before:from-cyan-300/50 before:via-violet-300/25 before:to-transparent sm:before:left-[1.55rem]">
          {experiences.map((experience) => (
            <article class="relative grid grid-cols-[2.5rem_1fr] gap-5 sm:grid-cols-[3.2rem_1fr] sm:gap-7">
              <div class="relative z-10 mt-8 grid h-9 w-9 place-items-center rounded-full border border-slate-700 bg-slate-950 sm:h-12 sm:w-12">
                <span class={`h-2.5 w-2.5 rounded-full ${experience.accent} shadow-[0_0_16px_currentColor]`}></span>
              </div>
              <div class="content-card p-6 sm:p-8">
                <div class="flex flex-col gap-4 border-b border-cyan-200/10 pb-5 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h2 class="text-xl font-bold text-white sm:text-2xl">{experience.organization}</h2>
                    <p class="mt-2 font-semibold text-cyan-200">{experience.role}</p>
                  </div>
                  <div class="text-sm leading-6 text-slate-500 sm:text-right">
                    <p>{experience.period}</p>
                    <p>{experience.location}</p>
                  </div>
                </div>
                <ul class="mt-6 space-y-3">
                  {experience.details.map((detail) => (
                    <li class="flex gap-3 text-sm leading-7 text-slate-300">
                      <span class="mt-[0.7rem] h-1 w-1 shrink-0 rounded-full bg-cyan-300"></span>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
