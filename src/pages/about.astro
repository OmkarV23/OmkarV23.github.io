---
import Layout from '../layouts/Layout.astro';

const education = [
  {
    school: 'Arizona State University',
    degree: 'Ph.D. · Electrical and Computer Engineering',
    period: 'May 2024 — Present',
    details: 'Imaging Lyceum Lab · Advisor: Dr. Suren Jayasuriya · Expected Fall 2028',
    accent: 'text-cyan-200',
  },
  {
    school: 'Arizona State University',
    degree: 'M.S. · Robotics and Artificial Intelligence',
    period: 'August 2022 — May 2024',
    details: 'GPA 3.91 / 4.00',
    accent: 'text-violet-200',
  },
  {
    school: 'University of Pune',
    degree: 'B.Tech. · Electronics and Telecommunication',
    period: 'August 2016 — May 2020',
    details: 'GPA 3.8 / 4.00',
    accent: 'text-teal-200',
  },
];

const principles = [
  {
    icon: 'fa-ruler-combined',
    title: 'Model the physics',
    body: 'Start with how light, sound, or radio waves interact with the world—then turn that image-formation model into something differentiable.',
  },
  {
    icon: 'fa-code',
    title: 'Own the system',
    body: 'Move comfortably from calibrated capture hardware and signal processing to CUDA kernels, inverse solvers, and neural representations.',
  },
  {
    icon: 'fa-eye',
    title: 'Reveal the invisible',
    body: 'Build practical imaging systems for depth, motion, acoustic structure, refractive fields, and phenomena that RGB cameras cannot directly observe.',
  },
];
---

<Layout title="About — Omkar Vengurlekar">
  <main>
    <header class="page-hero">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="max-w-4xl">
            <p class="eyebrow">About my research</p>
            <h1 class="mt-6 text-5xl font-bold tracking-[-0.055em] text-white sm:text-6xl lg:text-7xl">
              Physics, rendering, and <span class="gradient-text">signals.</span>
            </h1>
            <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-300">
              I’m a Ph.D. student in computational imaging at Arizona State University. My work combines physics-based differentiable rendering and neural scene representations with unconventional sensing modalities, including time-of-flight and Schlieren imaging.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/files/Omkar_Vengurlekar_Resume.pdf" target="_blank" rel="noopener noreferrer" class="button-primary"><i class="fas fa-file-arrow-down"></i> Résumé PDF</a>
            <a href="https://scholar.google.com/citations?user=wpP8K-4AAAAJ" target="_blank" rel="noopener noreferrer" class="button-secondary"><i class="fas fa-graduation-cap"></i> Scholar</a>
          </div>
        </div>
      </div>
    </header>

    <section class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
          <div>
            <p class="section-kicker">Research philosophy</p>
            <h2 class="section-heading">Full-stack computational imaging.</h2>
          </div>
          <div class="space-y-6 text-lg leading-9 text-slate-300">
            <p>I develop the full pipeline—from custom CUDA and OptiX renderers and adjoint solvers to calibrated multi-camera capture hardware.</p>
            <p class="text-slate-400">I’m especially interested in systems that recover information that is hidden, too fast, or too subtle for conventional cameras: megahertz depth and vibration, complex acoustic scattering, and dynamic 3D refractive-index fields.</p>
          </div>
        </div>

        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          {principles.map((principle) => (
            <article class="content-card p-7 sm:p-8">
              <div class="domain-icon"><i class={`fas ${principle.icon}`} aria-hidden="true"></i></div>
              <h3 class="mt-8 text-2xl font-bold tracking-tight text-white">{principle.title}</h3>
              <p class="mt-4 text-sm leading-7 text-slate-400">{principle.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell border-t border-cyan-300/10 bg-slate-950/35">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="section-kicker">Education</p>
        <h2 class="section-heading">Academic path</h2>
        <div class="mt-12 grid gap-5">
          {education.map((item, index) => (
            <article class="content-card grid gap-5 p-6 sm:grid-cols-[4rem_1fr_auto] sm:items-center sm:p-8">
              <span class={`text-3xl font-black ${item.accent}`}>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-xl font-bold text-white">{item.school}</h3>
                <p class="mt-2 text-slate-200">{item.degree}</p>
                <p class="mt-2 text-sm text-slate-500">{item.details}</p>
              </div>
              <p class="text-sm font-semibold text-slate-400 sm:text-right">{item.period}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
